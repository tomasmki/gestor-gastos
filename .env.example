# Copiá este archivo a .env.local y completá los valores.

# URL donde corre la app (tiene que coincidir con la redirect URI de Google).
APP_URL=http://localhost:3000

# --- Gmail (Google Cloud → APIs y servicios → Credenciales → ID de cliente OAuth) ---
# Redirect URI autorizada: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Splitwise (https://secure.splitwise.com/apps → registrá una app → "API key") ---
SPLITWISE_API_KEY=

# --- Opcionales ---
# Zona horaria para asignar cada gasto a su día/mes.
TIMEZONE=America/Argentina/Buenos_Aires
# Cuántos días hacia atrás se trae en la primera sincronización.
SYNC_DAYS=180
# Búsquedas de Gmail usadas para encontrar los mails (misma sintaxis que el buscador de Gmail).
# SANTANDER_GMAIL_QUERY=from:mensajesyavisos@mails.santander.com.ar
# MERCADOPAGO_GMAIL_QUERY=from:mercadopago.com
# Ruta de la base SQLite (por defecto ./data/gastos.db).
# DATABASE_PATH=./data/gastos.db
